{
    "name": "moltyapi",
    "scripts": {
        "dev": "bun run --hot src/server.ts",
        "db:push": "bunx --bun drizzle-kit push",
        "db:generate": "bunx --bun drizzle-kit generate",
        "db:migrate": "bunx --bun drizzle-kit migrate",
        "biome:write": "biome check --write --unsafe"
    },
    "dependencies": {
        "@hono/zod-validator": "^0.7.0",
        "@libsql/client": "^0.15.9",
        "dotenv": "^17.0.0",
        "drizzle-orm": "^0.44.2",
        "hono": "^4.8.3",
        "lefthook": "^1.11.14",
        "vitest": "^3.2.4",
        "zod": "^3.25.67"
    },
    "devDependencies": {
        "@biomejs/biome": "2.0.6",
        "@types/bun": "^1.2.17",
        "biome": "^0.3.3",
        "drizzle-kit": "^0.31.4"
    }
}
